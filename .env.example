# Application Port
PORT=3000

# Base URL for QR codes and notification links (e.g., http://localhost:3000 or https://yourdomain.com)
BASE_URL=http://localhost:3000

# Admin Access Password (Required for /admin and /admin/qr)
ADMIN_PASSWORD=admin123

# Secret for session tokens
AUTH_SECRET=change-this-to-a-secure-random-secret-in-production

# Email Notifications (Optional - leaves empty to skip alerts silently)
ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QR Site Checklist Alerts" <no-reply@qrsitechecklist.local>
