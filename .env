# Application Port
PORT=3000

# Base URL for QR codes and notification links
BASE_URL=http://localhost:3000

# Admin Access Password (Required for /admin and /admin/qr)
ADMIN_PASSWORD=admin123

# Secret for session tokens
AUTH_SECRET=qr-checklist-production-secret-987654321

# Email Notifications (Optional - leaves empty to skip alerts silently)
ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QR Site Checklist Alerts" <no-reply@qrsitechecklist.local>
